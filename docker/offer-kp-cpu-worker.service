[Unit]
Description=OfferKP CPU worker (matching / export / index-sync)
After=network.target redis-server.service offer-kp.service
Wants=redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/offer-kp/app/server
Environment=NODE_ENV=production
Environment=STORAGE_DIR=/opt/offer-kp/data
Environment=OFFER_KP_QUEUE=1
Environment=OFFER_KP_MATCHING_WORKER_CONCURRENCY=2
Environment=OFFER_KP_EXPORT_WORKER_CONCURRENCY=2
EnvironmentFile=-/opt/offer-kp/app/server/.env
ExecStart=/usr/local/bin/node /opt/offer-kp/app/server/jobs/offerKp-cpu-worker.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
